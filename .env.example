# Copy this file to .env and fill in the values below. .env is gitignored —
# never commit real secrets.

# --- LLM provider — required ---
# Any OpenAI-compatible chat completions API works: Chutes, OpenAI,
# OpenRouter, a local Ollama/vLLM server, etc. These Chutes values are defaults
# in configuration, not in the executable source.
LLM_BASE_URL=https://llm.chutes.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V3.2-TEE

# --- The account this bot protects — optional, defaults to maclong.dev ---
# TARGET_HANDLE=maclong.dev
# TARGET_DID=did:web:id.maclong.dev

# --- The bot's own AT Protocol account — required ---
# The bot runs on its own single-user Cirrus PDS deployment. Its endpoint is
# separate from the protected account's PDS.
BOT_PDS_URL=https://fairness.maclong.dev
BOT_HANDLE=fairness.maclong.dev
BOT_APP_PASSWORD=

# Optional: shown in the bot's own reply text.
# BOT_DISPLAY_NAME=Fairness Bot

# --- Advanced overrides — optional ---
# JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# APP_VIEW_URL=https://public.api.bsky.app
# STATE_DIR=state
# BOT_AVATAR_PATH=assets/logo.png

# Replies are scored 0-100 on three separate axes (rhetoric, relevance,
# evidence); the gate is the weakest of the three, not their average.
# Replies gating below this are treated as unfair and get a callout reply.
# FAIRNESS_SCORE_THRESHOLD=60

BOT_PROFILE_DESCRIPTION="Automated account that encourages fair, evidence-based discussion."
BOT_DISPLAY_NAME="Fairness Bot"

# Optional second-model review gate. When configured, it must approve and may
# make only minimal edits before an unfair reply is posted. It can also
# overturn the first model's finding outright, not just edit the reply.
# LLM_REVIEW_MODEL=
# LLM_REVIEW_BASE_URL=
# LLM_REVIEW_API_KEY=

# Optional, off by default. When enabled, the bot also judges the target
# account's own outgoing replies to other people, not just replies made to
# the target. An unfair self-review never posts a public counter-reply —
# it only publishes a verdict record with selfAssessment: true and no reply.
# SELF_REVIEW_ENABLED=false
